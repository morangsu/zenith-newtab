{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.13.3",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 Zenith 起始页",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "background": {
    "scripts": [
      "sync-core.js",
      "background.js"
    ]
  },
  "permissions": [
    "unlimitedStorage",
    "storage"
  ],
  "optional_permissions": [
    "bookmarks",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src https: http:; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zenith-newtab@morangsu.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
